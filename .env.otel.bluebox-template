# OTel configuration template — managed by Bluebox
#
# IMPORTANT: Before editing this file, load the bluebox-otel-instrumentation skill
# in your coding agent. The skill completes all language-specific SDK wiring.
#
# Token security: your ingest token belongs in your secret manager or CI secrets,
# NEVER in this file, NEVER committed to version control.
# When you need to set the Authorization header in your SDK or collector, use:
#   Authorization=Api-Token <your-ingest-token>
# (replace <your-ingest-token> with the actual token from your Bluebox workspace).

# Fixed: use http/protobuf — do NOT switch to gRPC/port 4317.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Explicitly select the HTTP/protobuf exporter entry point.
# Without these, the SDK falls back to otlp_proto_grpc when the protocol var is absent.
OTEL_TRACES_EXPORTER=otlp_proto_http
OTEL_METRICS_EXPORTER=otlp_proto_http
OTEL_LOGS_EXPORTER=otlp_proto_http

# OTLP ingest endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ccl14051.live.dynatrace.com/api/v2/otlp

# Service identity — fill in before starting your app.
OTEL_SERVICE_NAME=habit-tracker-backend

# Additional resource attributes — fill in as needed.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=habit-tracker,deployment.environment=development

# Authorization header — token belongs in your secret store, NOT in this file.
# Copy to .env.otel (git-ignored) and set:
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token <your-ingest-token>
